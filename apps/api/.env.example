# ── Runtime ─────────────────────────────────────────────
NODE_ENV=development
PORT=4100
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Next.js rewrite = 1). Used for client IPs in rate limiting.
TRUSTED_PROXY_HOPS=1
# Comma-separated origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:3100

# ── Data stores ─────────────────────────────────────────
# Replica set is required for transactions; directConnection avoids host discovery through Docker.
MONGODB_URI=mongodb://localhost:27027/doctor_tracker?replicaSet=rs0&directConnection=true
# Connections per API instance. Use ~5–10 on serverless platforms.
MONGODB_MAX_POOL_SIZE=50
# Optional. When empty or unreachable, the API keeps working without cache (fail-open).
REDIS_URL=redis://localhost:6389

# ── Auth ────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
REFRESH_TOKEN_SECRET=replace-with-another-long-random-string-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Set true in production behind HTTPS.
COOKIE_SECURE=false

# ── Seed (used by `pnpm seed`) ──────────────────────────
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_FULL_NAME=Avery Admin
SEED_DOCTOR_COUNT=60
SEED_PATIENT_COUNT=2400
